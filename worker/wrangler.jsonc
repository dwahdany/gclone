// gclone's auth Worker. Several things in this file are security requirements (README.md, "Configuration");
// scripts/check-config.mjs asserts them on every `npm test`:
//   - nothing of a request beyond the Worker's own log line (route, status, error code) is stored: invocation logs
//     are off, query strings are redacted, traces are off, and nothing is exported
//   - there is no "vars" key: ALLOWED_EMAILS is a secret only
//   - RATE_LIMIT (30 requests per 60 s and client address) and ASSETS are the only bindings, and there is no storage
//     of any kind. ASSETS is the hosted viewer's static files (./dist, built by another step — see README.md,
//     "The viewer's files"): read-only, uploaded with the Worker, changed only by a deploy. Its routing is fixed:
//     /a/* and /sw.js are answered by the asset layer without running the Worker; every other path runs the Worker,
//     which alone decides what it means; no HTML path rewriting and no single-page fallback
//   - "main" is src/entry.ts, the module that exports the handler and nothing else
//   - the check is an allowlist: a key that is not in this file as shipped is refused, whatever it is — no other
//     binding, no "unsafe" (unsafe.bindings attaches any binding type), and no "env": an environment inherits no
//     bindings, so `wrangler deploy --env <name>` would deploy a Worker without RATE_LIMIT
//   - no versioned preview hosts: an old version of the Worker must not stay reachable under another name
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gclone-auth",
  "main": "src/entry.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "gclone.wahdany.eu", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "ratelimits": [ { "name": "RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } } ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/a/*", "!/sw.js"],
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
