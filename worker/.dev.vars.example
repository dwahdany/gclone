# For `wrangler dev` only: copy to .dev.vars (git-ignored) and fill in. The deployed Worker gets the same names
# with `wrangler secret put` — never from a file, and never as "vars" in wrangler.jsonc.
# The OAuth client of type "TVs and Limited Input devices":
GOOGLE_CLIENT_ID="000000000000-placeholder.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="placeholder-client-secret"
# comma-separated Google account addresses; empty = nobody may sign in
ALLOWED_EMAILS="you@example.com"
# Only for the hosted viewer's sign-in (/web/*), which is on when all three are set. The OAuth client of type
# "Web application" (the names date from gclone < 0.2.0, when this client served the browser sign-in):
# GOOGLE_LEGACY_CLIENT_ID="000000000000-web.apps.googleusercontent.com"
# GOOGLE_LEGACY_CLIENT_SECRET="web-client-secret"
# 32 random bytes in base64, the key of the viewer's session cookie; make your own with: openssl rand -base64 32
# SEAL_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
